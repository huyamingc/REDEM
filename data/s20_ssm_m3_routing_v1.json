      "n_segments": 6,
      "t_total": 18000,
      "seed_rules": "verbatim from s18"
    },
    "metrics": {
      "stream_ppl": "exp(mean CE) over the stream, predict-before-update",
      "neg_frac": "fraction of clipped (<=0) predictions",
